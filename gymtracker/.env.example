# Copia in .env e compila con i valori del tuo progetto Supabase.
# Project Settings -> API -> Project URL e chiave "anon / public".
#
# L'URL è quello BASE del progetto, senza /rest/v1/ finale: supabase-js
# aggiunge da sé i suffissi dei vari servizi (rest, auth, storage).
#
# Usa SOLO la anon key. La service_role key scavalca la RLS per l'intero
# progetto e Vite inlinea ogni variabile VITE_* nel bundle pubblico: metterla
# qui significherebbe pubblicare un segreto.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
